# Required: Anthropic API key for the query agent
ANTHROPIC_API_KEY=sk-ant-...

# WIP API key: the key file issued when this project was installed (read on
# startup, so a replaced key is picked up on restart). WIP_API_KEY=<key> is an
# inline fallback; there is no default key.
WIP_API_KEY_FILE=<path to the WIP API key file for the target instance>

# WIP connection (stdio mode — local development)
# MCP_PYTHON=<path to the World-in-a-Pie venv python>
# MCP_CWD=<path to a World-in-a-Pie checkout>

# WIP REST proxy (server-side @wip/proxy injects this key on /wip/* requests)
# Defaults to https://wip-kb.local (the cluster ingress).
# WIP_BASE_URL=https://wip-kb.local

# WIP connection (remote mode — K8s/server)
# MCP_URL=http://wip-mcp-server:8007/mcp
# MCP_TRANSPORT=http

# OIDC authentication (optional — enables user login via Dex)
# Set OIDC_ISSUER to enable auth. Users are redirected to Dex login.
# OIDC_ISSUER=http://localhost:5556/dex
# OIDC_CLIENT_ID=wip-apps
# OIDC_CLIENT_SECRET=wip-apps-secret
# SESSION_SECRET=change-me-to-a-random-string

# App-level access control (optional — restricts which Dex groups can use this app)
# Comma-separated group names. Empty or unset = all authenticated users allowed.
# ALLOWED_GROUPS=wip-admins,clintrial-users

# --- Namespaces (CASE-551) ---
# These server-side vars are the SINGLE source of truth for namespace config. The
# client fetches them at boot via GET /api/app-config (no VITE_* namespace bake),
# so there is nothing to drift — do NOT mirror these into VITE_* vars.
# Corpus namespace (cases, decisions, lessons, sessions, memory, …):
WIP_NAMESPACE=dev-kb
# Technical Library namespace (generated-from-code docs):
KB_LIBRARY_NAMESPACE=library

# Optional: Claude model (default: claude-haiku-4-5-20251001)
# CLAUDE_MODEL=claude-sonnet-4-5-20241022

# Optional: session TTL in minutes (default: 30)
# SESSION_TTL_MINUTES=30

# Optional: max tool-call turns per question (default: 15)
# MAX_TURNS=15
