{
  "value": "AGENT_IDENTITY",
  "label": "Agent Identity",
  "description": "A purpose-built worker agent (CASE-1291): agent_value is its name as it signs sessions (RESPOND-YAC); performs lists the kinds of work it does (CLAIM_KIND), serves the owners whose cases it works on (KB_TARGET_YAC), active whether a dispatcher may pick it, runs how it is started. Owners are KB_TARGET_YAC terms, not records here. usage:reference (LOV).",
  "usage": "reference",
  "identity_fields": ["agent_value"],
  "fields": [
    { "name": "title",        "label": "Display Name", "type": "string",  "mandatory": true, "full_text_indexed": true },
    { "name": "authored_by",  "label": "Authored By",  "type": "string",  "mandatory": true },
    { "name": "doc_status",   "label": "Doc Status",   "type": "term",    "mandatory": true, "reference_type": "term", "terminology_ref": "KB_DOC_STATUS", "default_value": "draft" },
    { "name": "tags",         "label": "Tags",         "type": "array",   "array_item_type": "string" },
    { "name": "root",         "label": "Root",         "type": "boolean", "default_value": false },
    { "name": "agent_value",  "label": "Agent Value",  "type": "string",  "mandatory": true },
    { "name": "description",  "label": "Description",  "type": "string",  "full_text_indexed": true },
    { "name": "performs",     "label": "Performs",     "type": "array",   "array_item_type": "term", "array_terminology_ref": "CLAIM_KIND" },
    { "name": "serves",       "label": "Serves",       "type": "array",   "array_item_type": "term", "array_terminology_ref": "KB_TARGET_YAC" },
    { "name": "active",       "label": "Active",       "type": "boolean" },
    { "name": "runs",         "label": "How It Runs",  "type": "string" }
  ]
}
